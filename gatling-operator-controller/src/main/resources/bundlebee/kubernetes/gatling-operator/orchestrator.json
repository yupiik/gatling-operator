{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "{{orchestrator.name:-orchestrator}}",
    "labels": {{orchestrator.labels:- {} }},
    "annotations": {{orchestrator.annotations:- {} }}
  },
  "spec": {
    "backoffLimit": {{orchestrator.backoffLimit:-0}},
    "ttlSecondsAfterFinished": {{orchestrator.ttlSecondsAfterFinished:-300}},
    "template": {
      "metadata": {
        "labels": {{orchestrator.podLabels:- {{orchestrator.labels:- {} }} }},
        "annotations": {{orchestrator.podAnnotations:- {} }}
      },
      "spec": {
        "activeDeadlineSeconds": {{orchestrator.activeDeadlineSeconds:-6000}},
        "imagePullSecrets": {{orchestrator.imagePullSecrets:- [] }},
        "automountServiceAccountToken": {{orchestrator.automountServiceAccountToken:-true}},
        "serviceAccountName": "{{orchestrator.serviceAccountName:-gatling-orchestrator}}",
        "securityContext": {{orchestrator.podSecurityContext:- {"capabilities":{"drop":["ALL"]},"readOnlyRootFilesystem":true,"runAsNonRoot":true,"runAsUser":10000,"allowPrivilegeEscalation":false} }},
        "dnsConfig": {{orchestrator.dnsConfig:- {"options":[{"name":"ndots","value":"2"}]} }},
        "restartPolicy": "{{orchestrator.restartPolicy:-Never}}",
        "nodeSelector": {{orchestrator.nodeSelector:- {} }},
        "affinity": {{orchestrator.affinity:- {} }},
        "tolerations": {{orchestrator.tolerations:- [] }},
        "initContainers": {{orchestrator.initContainers:- [] }},
        "containers": [
          {
            "name": "orchestrator",
            "image": "{{orchestrator.image:-yupiik/gatling-cli:latest}}",
            "imagePullPolicy": "{{orchestrator.imagePullPolicy:-Always}}",
            "args": {{orchestrator.args:- [] }},
            "env": {{orchestrator.env:- [] }},
            "workingDir": "/tmp",
            "securityContext": {{orchestrator.containerSecurityContext:- {"fsGroup":10000,"fsGroupChangePolicy":"OnRootMismatch","seccompProfile":{"type":"RuntimeDefault"}} }},
            "resources": {{orchestrator.resources:- {"limits":{"memory":"{{orchestrator.memory:-128Mi}}"},"requests":{"cpu":"{{orchestrator.cpu:-100m}}","memory":"{{orchestrator.memory:-128Mi}}"}} }}
          }
        ]
      }
    }
  }
}